{
  "entities": {
    "ServerVaultManifest": {
      "title": "ServerVaultManifest",
      "description": "Authoritative cloud persistence manifest for SEC QCMS PRO Procedure 155 server state.",
      "type": "object",
      "properties": {
        "vaultKey": {
          "type": "string",
          "description": "Cryptographic capability key identifying the authorized server instance.",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "number",
          "description": "Monotonic server state version timestamp."
        },
        "updatedAtIso": {
          "type": "string",
          "description": "ISO-8601 timestamp of the last cloud commit.",
          "minLength": 10,
          "maxLength": 64
        },
        "workOrderCount": {
          "type": "number",
          "description": "Total number of active work orders persisted across chunks."
        },
        "tableCount": {
          "type": "number",
          "description": "Total number of configured tables."
        },
        "userCount": {
          "type": "number",
          "description": "Total number of registered platform accounts."
        },
        "chunkCount": {
          "type": "number",
          "description": "Total number of chunk documents in the chunks subcollection."
        },
        "chunkIds": {
          "type": "array",
          "description": "Ordered list of chunk document IDs storing workOrders and templates."
        },
        "coreJson": {
          "type": "string",
          "description": "Serialized core metadata including tables, users, tombstones, settings, and layout styles.",
          "minLength": 2,
          "maxLength": 900000
        }
      },
      "required": [
        "vaultKey",
        "version",
        "updatedAtIso",
        "workOrderCount",
        "tableCount",
        "userCount",
        "chunkCount",
        "chunkIds",
        "coreJson"
      ]
    },
    "ServerVaultChunk": {
      "title": "ServerVaultChunk",
      "description": "Chunked storage unit for SEC QCMS PRO work orders and templates to respect the 1MB Firestore document boundary.",
      "type": "object",
      "properties": {
        "vaultKey": {
          "type": "string",
          "description": "Parent server vault capability key.",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkId": {
          "type": "string",
          "description": "Unique identifier of this chunk.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkType": {
          "type": "string",
          "description": "Category of data stored in this chunk.",
          "enum": ["workOrders", "customTemplate", "extraCore"]
        },
        "chunkIndex": {
          "type": "number",
          "description": "Zero-based sequence index of the chunk."
        },
        "version": {
          "type": "number",
          "description": "State version associated with this chunk."
        },
        "updatedAtIso": {
          "type": "string",
          "description": "ISO-8601 timestamp when the chunk was written.",
          "minLength": 10,
          "maxLength": 64
        },
        "payloadJson": {
          "type": "string",
          "description": "Serialized JSON slice for this chunk.",
          "minLength": 1,
          "maxLength": 900000
        }
      },
      "required": [
        "vaultKey",
        "chunkId",
        "chunkType",
        "chunkIndex",
        "version",
        "updatedAtIso",
        "payloadJson"
      ]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "SEC Procedure 155 construction quality governance work order record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique work order document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "description": "Official SEC work order number.",
          "minLength": 1,
          "maxLength": 128
        },
        "tableId": {
          "type": "string",
          "description": "Associated table identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated creator or owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Governance workflow state.",
          "enum": ["open", "in_progress", "completed", "archived"]
        },
        "contractorName": {
          "type": "string",
          "description": "Assigned contractor name.",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server modification timestamp."
        }
      },
      "required": [
        "id",
        "orderNumber",
        "tableId",
        "ownerId",
        "status",
        "contractorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator registry document for RBAC verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin record was provisioned."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "ServerVaultLivePulse": {
      "title": "ServerVaultLivePulse",
      "description": "Ultra-fast live broadcast pulse document for real-time Firestore multi-user synchronization.",
      "type": "object",
      "properties": {
        "vaultKey": {
          "type": "string",
          "description": "Parent server vault capability key.",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pulseId": {
          "type": "string",
          "description": "Unique identifier of the pulse event or static sync channel.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "description": "Realtime broadcast event type.",
          "minLength": 2,
          "maxLength": 64
        },
        "eventId": {
          "type": "string",
          "description": "Unique event trace identifier.",
          "minLength": 1,
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "Client ID of the originating session.",
          "minLength": 1,
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the user who performed the action.",
          "maxLength": 256
        },
        "senderEmail": {
          "type": "string",
          "description": "Email of the originating user.",
          "maxLength": 256
        },
        "senderRole": {
          "type": "string",
          "description": "Role of the originating user.",
          "maxLength": 128
        },
        "version": {
          "type": "number",
          "description": "Monotonic version timestamp of the update."
        },
        "updatedAtIso": {
          "type": "string",
          "description": "ISO-8601 timestamp of the mutation.",
          "minLength": 10,
          "maxLength": 64
        },
        "payloadJson": {
          "type": "string",
          "description": "Serialized JSON delta of the modified entity or event payload.",
          "minLength": 1,
          "maxLength": 900000
        }
      },
      "required": [
        "vaultKey",
        "pulseId",
        "eventType",
        "eventId",
        "version",
        "updatedAtIso",
        "payloadJson"
      ]
    }
  },
  "firestore": {
    "/serverVaults/{vaultKey}": {
      "schema": { "$ref": "#/entities/ServerVaultManifest" },
      "description": "Authoritative cloud persistence manifest for SEC QCMS PRO server state."
    },
    "/serverVaults/{vaultKey}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ServerVaultChunk" },
      "description": "Chunked payload storage under a specific server vault manifest."
    },
    "/serverVaults/{vaultKey}/live_pulse/{pulseId}": {
      "schema": { "$ref": "#/entities/ServerVaultLivePulse" },
      "description": "Real-time live synchronization pulse for instant broadcast across all connected clients."
    },
    "/workOrders/{orderId}": {
      "schema": { "$ref": "#/entities/WorkOrder" },
      "description": "Direct client-accessible work order records protected by strict RBAC and ownership rules."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup collection for zero-trust role verification."
    }
  }
}
